{
  "name": "@coderifts/prove",
  "private": false,
  "version": "0.1.2",
  "description": "Reference offline enforcement for cr.exec.v1 execution grants + a demo API where mutation without a grant is 403.",
  "license": "MIT",
  "workspaces": [
    "packages/middleware",
    "demo"
  ],
  "scripts": {
    "test": "node --test \"packages/middleware/test/*.test.js\"",
    "test:pg": "node --test --test-concurrency=1 \"demo/test/*.test.js\"",
    "test:all": "npm test && npm run test:pg",
    "prove": "node demo/prove.js",
    "prove:all": "node bin/prove-all.js",
    "prove:check": "node bin/prove-all.js --check"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/prove-all.js",
    "demo/prove.js",
    "demo/e2e-chain.js",
    "demo/gen-keys.js",
    "demo/issue-grant.js",
    "demo/bundle.js",
    "demo/offline-check.js",
    "demo/src/",
    "demo/fixtures/",
    "demo/sql/",
    "demo/package.json",
    "demo/SELF-HOST.md",
    "packages/verifier-core/",
    "packages/middleware/src/",
    "examples/atomic-v2/",
    "examples/sample-transcript/",
    "docs/adapter-strength.v1.json",
    "README.md",
    "LICENSE",
    "!demo/keys",
    "!**/*.pem"
  ],
  "bin": {
    "coderifts-prove": "bin/prove-all.js"
  }
}
